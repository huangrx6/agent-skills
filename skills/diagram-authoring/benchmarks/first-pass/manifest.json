        },
        {
          "from": "worker",
          "to": "core"
        }
      ]
    },
    {
      "id": "order-state",
      "type": "state",
      "prompt": "画订单状态机：待支付 → 已支付 → 已发货 → 已完成；支付超时回到待支付前是已取消；已发货可以部分退款到已退款。",
      "required_nodes": [
        {
          "aliases": [
            "待支付",
            "pending",
            "等待支付"
          ],
          "kind": "plain"
        },
        {
          "aliases": [
            "已支付",
            "paid"
          ],
          "kind": "plain"
        },
        {
          "aliases": [
            "已发货",
            "shipped"
          ],
          "kind": "plain"
        },
        {
          "aliases": [
            "已完成",
