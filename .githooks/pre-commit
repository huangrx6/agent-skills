#!/bin/sh
# 结构、泄露、指针与文档数字错误阻塞提交。
# 回归失败默认只提示；AGENT_SKILLS_GATE=1 时阻塞。体检与锁同步只提示。
# 只对 skills/、tests/、tools/、.githooks/ 的改动运行。
# 安装：git config core.hooksPath .githooks

if ! git diff --cached --name-only -z | tr '\0' '\n' | grep -qE '^(skills|tests|tools|\.githooks)/'; then
  exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "⚠ pre-commit: 未找到 python3，跳过校验"
  exit 0
fi

ROOT=$(git rev-parse --show-toplevel)

fail() {
  echo "$1"
  echo ""
  echo "✗ pre-commit: $2，提交已中止"
  echo "  修好后重试；确需跳过：git commit --no-verify"
  exit 1
}

# ── 1. 结构校验 ──
VALIDATOR="$ROOT/skills/skill-builder/scripts/validate_skill.py"
if [ -f "$VALIDATOR" ]; then
  OUT=$(python3 "$VALIDATOR" 2>&1)
  STATUS=$?
  if [ "$STATUS" -ne 0 ]; then
    fail "$OUT" "skill 结构校验失败"
  fi
fi

# ── 2. 泄露扫描 ──
# 未配置 blocklist 时脚本自己会跳过并返回 0，所以不会挡流程。
LEAK="$ROOT/skills/skill-builder/scripts/check_leakage.py"
if [ -f "$LEAK" ]; then
  OUT=$(python3 "$LEAK" 2>&1)
  STATUS=$?
  if [ "$STATUS" -ne 0 ]; then
    fail "$OUT" "发现不该外发的真实名称"
  fi
fi

# ── 3. 脚本回归测试 ──
# 按目录分进程执行，避免一个模块中断其余 skill 的测试。
TEST_FAILURES=0
TEST_SUITES=0
TEST_SKIPPED=0
for d in "$ROOT"/tests/* "$ROOT"/tools/tests; do
  [ -d "$d" ] || continue
  TEST_SUITES=$((TEST_SUITES + 1))
  OUT=$(cd /tmp && python3 -m unittest discover -s "$d" 2>&1)
  STATUS=$?
  # 默认**不阻塞**：测试是给自己留的回归网，不是每次提交的门票（用户明确要求
  # 「以后不能再影响我」）。想把它当发布闸门时：AGENT_SKILLS_GATE=1 git commit …。
  if [ "$STATUS" -ne 0 ]; then
    TEST_FAILURES=$((TEST_FAILURES + 1))
    if [ "${AGENT_SKILLS_GATE:-0}" = "1" ]; then
      fail "$OUT" "「$(basename "$d")」的回归测试失败"
    else
      printf '\n── 回归测试失败（不阻塞提交）: %s ──\n%s\n' "$(basename "$d")" "$OUT" >&2
      printf '   想当发布闸门跑：AGENT_SKILLS_GATE=1 git commit …\n' >&2
    fi
  fi

  SKIPPED=$(printf '%s\n' "$OUT" | sed -n 's/.*skipped=\([0-9][0-9]*\).*/\1/p' | tail -1)
  TEST_SKIPPED=$((TEST_SKIPPED + ${SKIPPED:-0}))
  # Ran 数包含 skip；这里只比文档声称的总用例数，不把它当作通过数。
  COUNT=$(printf '%s\n' "$OUT" | sed -n 's/^Ran \([0-9][0-9]*\) test.*/\1/p' | head -1)
  # 文档在 skill 目录下（`skills/<skill>/`），测试在同名的顶层目录里。
  DOCS="$ROOT/skills/$(basename "$d")"
  [ -d "$DOCS" ] || DOCS="$ROOT/$(basename "$(dirname "$d")")"
  if [ -n "$COUNT" ] && [ -f "$ROOT/tools/check_doc_numbers.py" ]; then
    DOC_OUT=$(python3 "$ROOT/tools/check_doc_numbers.py" "$DOCS" --actual "$COUNT" 2>&1)
    if [ $? -ne 0 ]; then
      fail "$DOC_OUT" "$(basename "$DOCS") 的文档里测试条数过期了"
    fi
  fi
done

# ── 4. 指针目标存在性 ──
# 指针指向一个不存在的文件是客观错误。而“内容有没有真的搬过去”是语义判断 ——
# 那个脚本分不出（实测过：用词条计数会把整句散文当成主语，全是噪音），
# 留给 skill-builder 里的人工检查项。
# 它真正的作用是**把指针语句列出来**，让逐词核对有明确的范围。
POINTERS="$ROOT/skills/skill-builder/scripts/check_pointers.py"
if [ -f "$POINTERS" ]; then
  OUT=$(cd "$ROOT" && python3 "$POINTERS" --root "$ROOT" 2>&1)
  STATUS=$?
  if [ "$STATUS" -ne 0 ]; then
    fail "$OUT" "有指针指向不存在的文件"
  fi
fi

echo "✓ pre-commit: 已执行的结构、泄露、指针与文档数字检查通过"
if [ "$TEST_FAILURES" -gt 0 ]; then
  echo "⚠ 回归测试：$TEST_FAILURES 个目录失败（不阻塞提交）；跳过 $TEST_SKIPPED 条"
else
  echo "✓ 回归测试：$TEST_SUITES 个目录通过；跳过 $TEST_SKIPPED 条"
fi

# ── 5. 仓库体检（**只提示，不阻塞**）──
# 维护建议不作为提交门槛。
HEALTH="$ROOT/tools/skill_health.py"
if [ -f "$HEALTH" ]; then
  OUT=$(cd "$ROOT" && python3 "$HEALTH" 2>&1)
  NOTES=$(printf '%s\n' "$OUT" | sed -n '/值得看的/,$p')
  if [ -n "$NOTES" ]; then
    echo ""
    echo "── 体检提示（不阻塞提交）──"
    printf '%s\n' "$NOTES"
    echo "（这只是该优化什么，不是错误。想清完再提交也行。）"
  fi
fi

# ── 6. 同步 skills-lock.json（**派生文件：直接更新暂存版本**）──
# 哈希从暂存区计算；工作区锁文件若有未暂存内容则原样保留。
LOCK_SYNC="$ROOT/tools/skills_lock.py"
if [ -f "$LOCK_SYNC" ]; then
  LOCK_OUT=$(python3 "$LOCK_SYNC" --root "$ROOT" --staged --check 2>&1)
  if [ $? -ne 0 ]; then
    SYNC_OUT=$(python3 "$LOCK_SYNC" --root "$ROOT" --sync-index 2>&1)
    if [ $? -eq 0 ]; then
      echo ""
      printf '%s\n' "$SYNC_OUT"
    else
      printf '%s\n' "$SYNC_OUT" >&2
      echo "⚠ 无法同步 skills-lock.json，请运行锁文件工具检查（不阻塞提交）" >&2
    fi
  fi
fi

exit 0
