dist/

# subagent 探查报告（保留在工作区，不进 git 历史）
file-only/
# skill 打包产物（安装/分发用）。**曾被我误用 git add -A 扫进一次** —— 真要入库请用 git add -f
skills/*.zip

# deck-authoring 的 demo 产物（本地生成，不入库）。
# 仓库只收文本 + assets/icons 下两个 SVG；见该 skill 的 README「跑法」。
# 这条清单要**跟着产出物的种类长** —— 新加一种导出就得补一行，
# 漏一行就是让一个几 MB 的二进制摸进公共仓库（`out.pdf` / 两种 pptx 就是这么漏的）。
skills/deck-authoring/sample-treated.png
# 字体文件**不进仓库**：单款 CJK 字体 5–28MB，126 款就是 1–2GB。
# 仓库只存清单（fonts/catalog.json）与映射表（fonts/mapping.json），
# 换台机器跑 `python3 scripts/fonts.py --fetch` 自动取回来。
skills/deck-authoring/fonts/ttf/
_brief-probe.html
image-brief.md
skills/deck-authoring/pages/
skills/deck-authoring/out.html
skills/deck-authoring/out.html.measured.json
skills/deck-authoring/out.pdf
skills/deck-authoring/out.png.pptx
skills/deck-authoring/out.edit.pptx
skills/deck-authoring/deck.pptx
skills/deck-authoring/deck-editable.pptx
# 视频导出（animate.py）：成片 + 抽帧目录 + 临时帧目录
skills/deck-authoring/deck.mp4
skills/deck-authoring/deck.gif
skills/deck-authoring/*.mp4
skills/deck-authoring/*.gif
skills/deck-authoring/*.stills/
# 测试用的临时品牌（test_brand.py 建在真 brands/ 下，用完即删；
# 这一行是防它跑崩后残留被误提交）
skills/deck-authoring/brands/zz_test_*/
skills/deck-authoring/styles/zz_test_*/
